{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "deny"
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "nextjs"],
  "ignorePatterns": [".next/**", "build/**", "next-env.d.ts", "out/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "deny"
  }
}
